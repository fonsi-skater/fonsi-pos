# ──────────────────────────────────────────────────────────────
# Fonsi POS — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets.
# ──────────────────────────────────────────────────────────────

# Supabase
# Public — safe to expose to the browser (protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET — server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Safaricom Daraja (M-Pesa) — SECRET, server-only
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_ENV=sandbox
# Publicly reachable HTTPS URL Daraja will POST callbacks to:
MPESA_CALLBACK_URL=https://your-app-url.example.com/api/payments/mpesa/callback

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
